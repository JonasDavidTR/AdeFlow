 <Window x:Class="GeradorFichaCadastro.CadastroIndividualWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cadastro Individual"
        Height="700"
        Width="850"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Título -->

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,15">

            <TextBlock Text="Cadastro Individual"
                       FontSize="26"
                       FontWeight="Bold"/>

            <TextBlock Text="Preencha os dados para gerar uma ficha individual."
                       Foreground="Gray"
                       Margin="0,5,0,0"/>

        </StackPanel>


        <!-- Campos -->

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">

            <ItemsControl x:Name="CamposFormulario">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>

                    <DataTemplate>

                        <StackPanel Width="370"
                                    Margin="0,0,15,15">

                            <TextBlock Text="{Binding Nome}"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,5"/>

                            <TextBox Height="35"
                                     VerticalContentAlignment="Center"
                                     Tag="{Binding Marcador}"/>

                        </StackPanel>

                    </DataTemplate>

                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </ScrollViewer>


        <!-- Botões -->

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">

            <Button Content="CANCELAR"
                    Width="130"
                    Height="40"
                    Margin="0,0,10,0"
                    Click="BtnCancelar_Click"/>

            <Button Content="GERAR FICHA"
                    Width="150"
                    Height="40"
                    Click="BtnGerar_Click"/>

        </StackPanel>

    </Grid>

</Window>
